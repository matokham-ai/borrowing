APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI — not used (Google Cloud Vision is the active OCR engine)
# OPENAI_API_KEY=

# Google Cloud Vision API — KYC document OCR (free: 1000 units/month)
# Get your key: https://console.cloud.google.com/apis/credentials
# Enable API:   https://console.cloud.google.com/apis/library/vision.googleapis.com
# GOOGLE_CLOUD_VISION_API_KEY= (not used)

# OCR.space � free 25,000 pages/month, no billing, no credit card
# Get your free key at: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=

# ── M-Pesa / Daraja ────────────────────────────────────────────────────────
# Environment: 'production' for live, 'sandbox' for testing
MPESA_ENV=production

# ── C2B / STK Push ─────────────────────────────────────────────────────────
# Credentials from Daraja API Manager → your C2B app (Apps → Add New App).
# Sandbox test credentials: https://developer.safaricom.co.ke/test_credentials
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Paybill shortcode used for C2B payments / account validation.
# Sandbox default: 600984  |  Production: your registered paybill number.
MPESA_BUSINESS_SHORTCODE=4037237

# Till / shortcode used for STK Push (LipaNaMpesa Online).
# Sandbox default: 174379  |  Production: your LNM shortcode.
MPESA_STK_SHORTCODE=3014281

# STK Push passkey — issued by Safaricom alongside your LNM shortcode.
# Sandbox default passkey: bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_PASSKEY=

# ── B2C Disbursement ────────────────────────────────────────────────────────
# SEPARATE Daraja app from C2B — create a distinct B2C app in the portal.
# Sandbox test credentials: https://developer.safaricom.co.ke/test_credentials
MPESA_B2C_CONSUMER_KEY=
MPESA_B2C_CONSUMER_SECRET=

# B2C paybill / Organisation shortcode (PartyA in the B2C request).
# Confirm the production shortcode with Safaricom before setting/using it.
MPESA_B2C_SHORTCODE=3014281

# Exact API operator (initiator) username issued/configured by Safaricom.
# Do not use a shortcode or the sandbox username.
MPESA_INITIATOR_NAME=

# Security credential: your initiator password encrypted with Daraja's public key.
# Generate at: https://developer.safaricom.co.ke/test_credentials
# (select "Initiator Password" → enter your password → copy the encrypted value)
MPESA_SECURITY_CREDENTIAL=

# ── Callback URLs ───────────────────────────────────────────────────────────
# All three must be publicly reachable HTTPS endpoints that Safaricom can POST to.
# Leave blank to auto-build from APP_URL + org slug (service classes handle this).
# During development, use a tunnel such as ngrok: ngrok http 8000
MPESA_B2C_RESULT_URL=https://lendflow.taraknishi.com/api/mpesa/lendflow/b2c/result
MPESA_B2C_TIMEOUT_URL=https://lendflow.taraknishi.com/api/mpesa/lendflow/b2c/timeout

# ── Other Daraja products ──────────────────────────────────────────────────
# Configure credentials only for products enabled on the corresponding Daraja
# app. Do not copy B2C credentials here unless Safaricom confirms authorization.
MPESA_REVERSAL_CONSUMER_KEY=
MPESA_REVERSAL_CONSUMER_SECRET=
MPESA_REVERSAL_INITIATOR_NAME=
MPESA_REVERSAL_SECURITY_CREDENTIAL=
# Confirm the expected ReceiverParty with Safaricom before enabling reversals.
MPESA_REVERSAL_RECEIVER_PARTY=

MPESA_B2B_CONSUMER_KEY=
MPESA_B2B_CONSUMER_SECRET=
MPESA_B2B_INITIATOR_NAME=
MPESA_B2B_SECURITY_CREDENTIAL=

MPESA_OPERATIONS_CONSUMER_KEY=
MPESA_OPERATIONS_CONSUMER_SECRET=
MPESA_OPERATIONS_INITIATOR_NAME=
MPESA_OPERATIONS_SECURITY_CREDENTIAL=

MPESA_BILLMANAGER_CONSUMER_KEY=
MPESA_BILLMANAGER_CONSUMER_SECRET=
MPESA_STK_CALLBACK_URL=https://lendflow.taraknishi.com/api/mpesa/lendflow/stk/callback
